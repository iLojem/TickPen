<Window x:Class="TickPen.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TickPen Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowState="Maximized"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        PreviewKeyDown="OverlayWindow_PreviewKeyDown">

    <!--
        RootGrid alterna su Background entre:
        - Transparent (Modo Cursor / Click-Through activo)
        - #01000000 (Cualquier herramienta activa: captura eventos del mouse sin oscurecer la pantalla)
    -->
    <Grid x:Name="RootGrid" Background="Transparent">

        <!-- Contenedor principal de dibujos: su Visibility se alterna sin perder trazos ni formas -->
        <Grid x:Name="DrawingLayer" Visibility="Visible">

            <!-- Capa 1: Motor de tinta a mano alzada (Lápiz, Resaltador, Borrador de trazos) -->
            <InkCanvas x:Name="MainInkCanvas"
                       Background="Transparent"
                       EditingMode="None"
                       UseCustomCursor="False"
                       StrokeCollected="MainInkCanvas_StrokeCollected" />

            <!-- Capa 2: Motor vectorial para Formas Geométricas, Texto y Vista Previa -->
            <Canvas x:Name="VectorCanvas"
                    Background="Transparent"
                    IsHitTestVisible="False"
                    MouseLeftButtonDown="VectorCanvas_MouseLeftButtonDown"
                    MouseMove="VectorCanvas_MouseMove"
                    MouseLeftButtonUp="VectorCanvas_MouseLeftButtonUp" />

            <!-- Capa 2B: Elementos efímeros con animación Fade-Out automática -->
            <Canvas x:Name="FadeCanvas"
                    Background="Transparent"
                    IsHitTestVisible="False" />
        </Grid>

        <!-- Capa 3: Selector de región para Captura de Pantalla -->
        <Canvas x:Name="CaptureOverlayCanvas"
                Visibility="Collapsed"
                Background="#22000000"
                Cursor="Cross"
                MouseLeftButtonDown="CaptureOverlay_MouseLeftButtonDown"
                MouseMove="CaptureOverlay_MouseMove"
                MouseLeftButtonUp="CaptureOverlay_MouseLeftButtonUp">

            <Rectangle x:Name="SelectionRect"
                       Visibility="Collapsed"
                       Stroke="#FF38BDF8"
                       StrokeThickness="2"
                       StrokeDashArray="4 2"
                       Fill="#1A38BDF8" />

            <Border x:Name="SelectionSizeBadge"
                    Visibility="Collapsed"
                    Background="#DD0F172A"
                    CornerRadius="4"
                    Padding="6,3">
                <TextBlock x:Name="SelectionSizeText"
                           Foreground="White"
                           FontSize="12"
                           FontFamily="Segoe UI"
                           FontWeight="SemiBold" />
            </Border>
        </Canvas>
    </Grid>
</Window>
