<Window x:Class="TickPen.Views.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TickPen"
        Icon="pack://application:,,,/Assets/TickPen.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="True"
        PreviewKeyDown="ToolbarWindow_PreviewKeyDown">

    <Window.Resources>
        <!-- Estilo base para botones de herramientas (36x36) -->
        <Style x:Key="ToolBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource ButtonActiveBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para botones pequeños de cabecera y submodo -->
        <Style x:Key="MiniBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="22" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="5,2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource ButtonActiveBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para los 8 círculos de color -->
        <Style x:Key="ColorSwatchStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ring"
                                CornerRadius="12"
                                BorderThickness="2"
                                BorderBrush="Transparent"
                                Padding="2">
                            <Ellipse Fill="{TemplateBinding Background}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="#88FFFFFF" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para los 4 selectores de grosor -->
        <Style x:Key="ThicknessBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource ButtonActiveBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menú contextual oscuro para Captura de Pantalla -->
        <ContextMenu x:Key="ScreenshotMenu"
                     Background="#F21E293B"
                     Foreground="White"
                     BorderBrush="#44FFFFFF"
                     BorderThickness="1">
            <MenuItem Header="Región → Portapapeles" Click="MenuCaptureRegionClipboard_Click" />
            <MenuItem Header="Región → Guardar PNG..." Click="MenuCaptureRegionSave_Click" />
            <Separator Background="#33FFFFFF" />
            <MenuItem Header="Pantalla completa → Portapapeles" Click="MenuCaptureFullClipboard_Click" />
            <MenuItem Header="Pantalla completa → Guardar PNG..." Click="MenuCaptureFullSave_Click" />
        </ContextMenu>
    </Window.Resources>

    <!-- Contenedor externo con margen para que la sombra no se recorte -->
    <Border Margin="10"
            Background="{StaticResource ToolbarBgBrush}"
            BorderBrush="{StaticResource ToolbarBorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="6,6,6,8">
        <Border.Effect>
            <DropShadowEffect Color="Black"
                              BlurRadius="16"
                              ShadowDepth="4"
                              Opacity="0.55" />
        </Border.Effect>

        <StackPanel Width="80">
            <!-- Cabecera arrastrable + botón Colapsar + botón Cerrar -->
            <Grid x:Name="DragHeader"
                  Background="Transparent"
                  Cursor="SizeAll"
                  Margin="0,0,0,4"
                  MouseLeftButtonDown="DragHeader_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnCollapse"
                        Grid.Column="0"
                        Style="{StaticResource MiniBtnStyle}"
                        Width="24"
                        ToolTip="Colapsar / Expandir barra (Ctrl+Shift+H oculta)"
                        Click="BtnCollapse_Click">
                    <TextBlock x:Name="CollapseIcon" Text="▲" FontSize="10" />
                </Button>

                <!-- Indicador visual de agarre (grip) -->
                <StackPanel Grid.Column="1"
                            Orientation="Vertical"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            IsHitTestVisible="False">
                    <Rectangle Width="16" Height="2" RadiusX="1" RadiusY="1" Fill="#55FFFFFF" Margin="0,1" />
                    <Rectangle Width="16" Height="2" RadiusX="1" RadiusY="1" Fill="#55FFFFFF" Margin="0,1" />
                </StackPanel>

                <Button x:Name="BtnClose"
                        Grid.Column="2"
                        Style="{StaticResource MiniBtnStyle}"
                        Width="24"
                        ToolTip="Salir de TickPen"
                        Click="BtnClose_Click">
                    <TextBlock Text="✕" FontSize="11" />
                </Button>
            </Grid>

            <!-- Cuerpo colapsable de la barra -->
            <StackPanel x:Name="ToolbarBody">
                <Separator Background="{StaticResource DividerBrush}" Margin="2,2,2,6" />

                <!-- Bloque 1: Herramientas de dibujo (2 columnas) -->
                <UniformGrid Columns="2">
                    <!-- Cursor (Click-Through) -->
                    <Button x:Name="BtnCursor" Style="{StaticResource ToolBtnStyle}"
                            ToolTip="Modo Cursor / Click-Through (Ctrl+Shift+D)"
                            Click="BtnCursor_Click">
                        <Path Data="M4,2 L4,18 L8.5,14 L11.5,20 L13.8,19 L10.8,13 L16,13 Z"
                              Fill="White" Stretch="Uniform" Width="15" Height="15" />
                    </Button>

                    <!-- Lápiz -->
                    <Button x:Name="BtnPen" Style="{StaticResource ToolBtnStyle}"
                            ToolTip="Lápiz (Ctrl+Shift+D)"
                            Click="BtnPen_Click">
                        <Path Data="M3,17.25 V21 H6.75 L17.81,9.94 L14.06,6.19 Z M20.71,7.04 C21.1,6.65 21.1,6.02 20.71,5.63 L18.37,3.29 C17.98,2.9 17.35,2.9 16.96,3.29 L15.13,5.12 L18.88,8.87 Z"
                              Fill="White" Stretch="Uniform" Width="16" Height="16" />
                    </Button>

                    <!-- Resaltador -->
                    <Button x:Name="BtnHighlighter" Style="{StaticResource ToolBtnStyle}"
                            ToolTip="Resaltador semitransparente"
                            Click="BtnHighlighter_Click">
                        <Path Data="M6,14 L15,5 L19,9 L10,18 Z M4,16 L8,20 L3,21 Z M11,19 H21 V21 H11 Z"
                              Fill="#FFFACC15" Stretch="Uniform" Width="16" Height="16" />
                    </Button>

                    <!-- Borrador -->
                    <Button x:Name="BtnEraser" Style="{StaticResource ToolBtnStyle}"
                            ToolTip="Borrador (por trazo o por punto)"
                            Click="BtnEraser_Click">
                        <Path Data="M16.24,3.56 L21.19,8.5 C21.97,9.29 21.97,10.55 21.19,11.34 L12,20.53 C10.44,22.09 7.91,22.09 6.34,20.53 L2.81,17 C2.03,16.21 2.03,14.95 2.81,14.16 L13.41,3.56 C14.2,2.78 15.46,2.78 16.24,3.56 Z M4.22,15.58 L7.76,19.11 C8.54,19.9 9.8,19.9 10.59,19.11 L14.12,15.58 L9.17,10.63 L4.22,15.58 Z"
                              Fill="White" Stretch="Uniform" Width="16" Height="16" />
                    </Button>

                    <!-- Línea -->
                    <Button x:Name="BtnLine" Style="{StaticResource ToolBtnStyle}"
                            ToolTip="Línea recta (Shift para ángulos de 45°)"
                            Click="BtnLine_Click">
                        <Path Data="M4,18 L18,4"
                              Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform" />
                    </Button>

                    <!-- Flecha -->
                    <Button x:Name="BtnArrow" Style="{StaticResource ToolBtnStyle}"
                            ToolTip="Flecha (Shift para ángulos de 45°)"
                            Click="BtnArrow_Click">
                        <Path Data="M4,18 L18,4 M11,4 L18,4 L18,11"
                              Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="16" Height="16" Stretch="Uniform" />
                    </Button>

                    <!-- Rectángulo -->
                    <Button x:Name="BtnRectangle" Style="{StaticResource ToolBtnStyle}"
                            ToolTip="Rectángulo (Shift para cuadrado perfecto)"
                            Click="BtnRectangle_Click">
                        <Rectangle Width="15" Height="11" Stroke="White" StrokeThickness="2" RadiusX="1.5" RadiusY="1.5" />
                    </Button>

                    <!-- Elipse -->
                    <Button x:Name="BtnEllipse" Style="{StaticResource ToolBtnStyle}"
                            ToolTip="Elipse (Shift para círculo perfecto)"
                            Click="BtnEllipse_Click">
                        <Ellipse Width="15" Height="13" Stroke="White" StrokeThickness="2" />
                    </Button>

                    <!-- Texto -->
                    <Button x:Name="BtnText" Style="{StaticResource ToolBtnStyle}"
                            ToolTip="Insertar Texto (Enter para fijar, Esc para cancelar)"
                            Click="BtnText_Click">
                        <TextBlock Text="T" FontFamily="Georgia" FontSize="17" FontWeight="Bold" Foreground="White" />
                    </Button>

                    <!-- Captura de Pantalla -->
                    <Button x:Name="BtnScreenshot" Style="{StaticResource ToolBtnStyle}"
                            ToolTip="Captura de pantalla (Región o Pantalla completa)"
                            Click="BtnScreenshot_Click">
                        <Path Data="M4,7 H7 L9,4 H15 L17,7 H20 C21.1,7 22,7.9 22,9 V19 C22,20.1 21.1,21 20,21 H4 C2.9,21 2,20.1 2,19 V9 C2,7.9 2.9,7 4,7 Z M12,10 C9.79,10 8,11.79 8,14 C8,16.21 9.79,18 12,18 C14.21,18 16,16.21 16,14 C16,11.79 14.21,10 12,10 Z"
                              Fill="White" Stretch="Uniform" Width="16" Height="16" />
                    </Button>
                </UniformGrid>

                <!-- Sub-panel contextual para modo Borrador (Por Trazo / Por Punto) -->
                <Border x:Name="EraserModePanel"
                        Visibility="Collapsed"
                        Background="#1AFFFFFF"
                        CornerRadius="8"
                        Padding="2"
                        Margin="0,4,0,2">
                    <UniformGrid Columns="2">
                        <Button x:Name="BtnEraseStroke" Style="{StaticResource MiniBtnStyle}"
                                Content="Trazo" ToolTip="Borrar trazo completo"
                                Click="BtnEraseStroke_Click" />
                        <Button x:Name="BtnErasePoint" Style="{StaticResource MiniBtnStyle}"
                                Content="Punto" ToolTip="Borrar por punto"
                                Click="BtnErasePoint_Click" />
                    </UniformGrid>
                </Border>

                <!-- Botón Modo Fade (estilo ScreenBrush: desvanece dibujos tras X segundos) -->
                <Button x:Name="BtnFadeMode"
                        Style="{StaticResource MiniBtnStyle}"
                        Height="28"
                        Margin="2,6,2,0"
                        ToolTip="Modo Fade: los dibujos se desvanecen solos (Ctrl+Shift+F)"
                        Click="BtnFadeMode_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M12,2 L13.8,7.2 L19,9 L13.8,10.8 L12,16 L10.2,10.8 L5,9 L10.2,7.2 Z M18.5,14 L19.4,16.6 L22,17.5 L19.4,18.4 L18.5,21 L17.6,18.4 L15,17.5 L17.6,16.6 Z"
                              Fill="#FF38BDF8" Stretch="Uniform" Width="13" Height="13" Margin="0,0,5,0" />
                        <TextBlock x:Name="FadeBtnLabel" Text="Fade" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Selector de tiempo X para el Modo Fade -->
                <Border x:Name="FadeDurationPanel"
                        Visibility="Collapsed"
                        Background="#1AFFFFFF"
                        CornerRadius="8"
                        Padding="2"
                        Margin="2,4,2,0">
                    <UniformGrid Columns="2">
                        <Button x:Name="BtnFade2s" Style="{StaticResource MiniBtnStyle}" Content="2s" ToolTip="Desvanecer a los 2 segundos" Click="FadeDelay_Click" />
                        <Button x:Name="BtnFade4s" Style="{StaticResource MiniBtnStyle}" Content="4s" ToolTip="Desvanecer a los 4 segundos" Click="FadeDelay_Click" />
                        <Button x:Name="BtnFade6s" Style="{StaticResource MiniBtnStyle}" Content="6s" ToolTip="Desvanecer a los 6 segundos" Click="FadeDelay_Click" />
                        <Button x:Name="BtnFade10s" Style="{StaticResource MiniBtnStyle}" Content="10s" ToolTip="Desvanecer a los 10 segundos" Click="FadeDelay_Click" />
                    </UniformGrid>
                </Border>

                <Separator Background="{StaticResource DividerBrush}" Margin="2,6,2,6" />

                <!-- Bloque 2: Historial y Control de Lienzo -->
                <UniformGrid Columns="2">
                    <Button x:Name="BtnUndo" Style="{StaticResource ToolBtnStyle}"
                            ToolTip="Deshacer (Ctrl+Z)"
                            IsEnabled="False"
                            Click="BtnUndo_Click">
                        <Path Data="M12.5,8 C9.85,8 7.45,8.99 5.6,10.6 L2,7 V16 H11 L7.38,12.38 C8.77,11.22 10.54,10.5 12.5,10.5 C16.04,10.5 19.05,12.81 20.1,16 L22.47,15.22 C21.08,11.03 17.15,8 12.5,8 Z"
                              Fill="White" Stretch="Uniform" Width="16" Height="16" />
                    </Button>

                    <Button x:Name="BtnRedo" Style="{StaticResource ToolBtnStyle}"
                            ToolTip="Rehacer (Ctrl+Y)"
                            IsEnabled="False"
                            Click="BtnRedo_Click">
                        <Path Data="M18.4,10.6 C16.55,8.99 14.15,8 11.5,8 C6.85,8 2.92,11.03 1.54,15.22 L3.9,16 C4.95,12.81 7.95,10.5 11.5,10.5 C13.45,10.5 15.23,11.22 16.62,12.38 L13,16 H22 V7 L18.4,10.6 Z"
                              Fill="White" Stretch="Uniform" Width="16" Height="16" />
                    </Button>

                    <Button x:Name="BtnToggleInk" Style="{StaticResource ToolBtnStyle}"
                            ToolTip="Ocultar / Mostrar tinta sin borrar"
                            Click="BtnToggleInk_Click">
                        <Path x:Name="InkVisibilityIcon"
                              Data="M12,4.5 C7,4.5 2.73,7.61 1,12 C2.73,16.39 7,19.5 12,19.5 C17,19.5 21.27,16.39 23,12 C21.27,7.61 17,4.5 12,4.5 Z M12,17 C9.24,17 7,14.76 7,12 C7,9.24 9.24,7 12,7 C14.76,7 17,9.24 17,12 C17,14.76 14.76,17 12,17 Z M12,9 C10.34,9 9,10.34 9,12 C9,13.66 10.34,15 12,15 C13.66,15 15,13.66 15,12 C15,10.34 13.66,9 12,9 Z"
                              Fill="White" Stretch="Uniform" Width="17" Height="17" />
                    </Button>

                    <Button x:Name="BtnClear" Style="{StaticResource ToolBtnStyle}"
                            ToolTip="Limpiar pantalla (Ctrl+Shift+C)"
                            Click="BtnClear_Click">
                        <Path Data="M6,19 C6,20.1 6.9,21 8,21 H16 C17.1,21 18,20.1 18,19 V7 H6 V19 Z M19,4 H15.5 L14.5,3 H9.5 L8.5,4 H5 V6 H19 V4 Z"
                              Fill="#FFF87171" Stretch="Uniform" Width="15" Height="15" />
                    </Button>
                </UniformGrid>

                <Separator Background="{StaticResource DividerBrush}" Margin="2,6,2,6" />

                <!-- Bloque 3: Paleta de 8 Colores Vibrantes -->
                <UniformGrid x:Name="ColorGrid" Columns="2" HorizontalAlignment="Center">
                    <Button Style="{StaticResource ColorSwatchStyle}" Background="#FFEF4444" ToolTip="Rojo" Click="ColorSwatch_Click" />
                    <Button Style="{StaticResource ColorSwatchStyle}" Background="#FFF97316" ToolTip="Naranja" Click="ColorSwatch_Click" />
                    <Button Style="{StaticResource ColorSwatchStyle}" Background="#FFFACC15" ToolTip="Amarillo" Click="ColorSwatch_Click" />
                    <Button Style="{StaticResource ColorSwatchStyle}" Background="#FF22C55E" ToolTip="Verde" Click="ColorSwatch_Click" />
                    <Button Style="{StaticResource ColorSwatchStyle}" Background="#FF06B6D4" ToolTip="Cian" Click="ColorSwatch_Click" />
                    <Button Style="{StaticResource ColorSwatchStyle}" Background="#FF3B82F6" ToolTip="Azul" Click="ColorSwatch_Click" />
                    <Button Style="{StaticResource ColorSwatchStyle}" Background="#FFA855F7" ToolTip="Violeta" Click="ColorSwatch_Click" />
                    <Button Style="{StaticResource ColorSwatchStyle}" Background="#FFFFFFFF" ToolTip="Blanco" Click="ColorSwatch_Click" />
                </UniformGrid>

                <Separator Background="{StaticResource DividerBrush}" Margin="2,6,2,6" />

                <!-- Bloque 4: Selector de 4 Grosores de Trazo -->
                <UniformGrid x:Name="ThicknessGrid" Columns="2">
                    <Button x:Name="BtnSize1" Style="{StaticResource ThicknessBtnStyle}" ToolTip="Grosor fino (2 px)" Click="Thickness_Click">
                        <Ellipse Width="4" Height="4" Fill="White" />
                    </Button>
                    <Button x:Name="BtnSize2" Style="{StaticResource ThicknessBtnStyle}" ToolTip="Grosor medio (4 px)" Click="Thickness_Click">
                        <Ellipse Width="7" Height="7" Fill="White" />
                    </Button>
                    <Button x:Name="BtnSize3" Style="{StaticResource ThicknessBtnStyle}" ToolTip="Grosor grueso (8 px)" Click="Thickness_Click">
                        <Ellipse Width="11" Height="11" Fill="White" />
                    </Button>
                    <Button x:Name="BtnSize4" Style="{StaticResource ThicknessBtnStyle}" ToolTip="Grosor extra (14 px)" Click="Thickness_Click">
                        <Ellipse Width="15" Height="15" Fill="White" />
                    </Button>
                </UniformGrid>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
