<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>TickPen</AssemblyName>
    <RootNamespace>TickPen</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>TickPen Contributors</Authors>
    <Company>TickPen</Company>
    <Product>TickPen</Product>
    <Description>Herramienta open-source y ligera de anotación en pantalla para traders, analistas y presentaciones (.NET 8 WPF)</Description>
    <ApplicationIcon>Assets\TickPen.ico</ApplicationIcon>

    <!-- Privacidad de compilación: evita incrustar rutas locales del creador en el binario Release -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>

    <!-- Publicación autocontenida en un solo ejecutable para Windows x64 -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\TickPen.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Necesario para Graphics.CopyFromScreen y exportación PNG local -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

</Project>
