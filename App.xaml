<Application x:Class="TickPen.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Paleta global oscura estilo Epic Pen -->
        <SolidColorBrush x:Key="ToolbarBgBrush" Color="#EE111827" />
        <SolidColorBrush x:Key="ToolbarBorderBrush" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="ButtonActiveBrush" Color="#FF2563EB" />
        <SolidColorBrush x:Key="DividerBrush" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF8FAFC" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#FF94A3B8" />
    </Application.Resources>
</Application>
